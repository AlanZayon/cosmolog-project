# Next.js (server-only — not exposed to the browser)
# Rust API base URL for BFF routes (/api/auth/*, /api/proxy/*)
API_INTERNAL_URL=http://127.0.0.1:8080

# Google OAuth (or local Fake IdP when using docker-compose.dev.yml)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Local Fake IdP:
# GOOGLE_CLIENT_ID=cosmolog-local
# GOOGLE_AUTHORIZE_URL=http://localhost:9090/authorize

# Optional legacy fallback if API_INTERNAL_URL is unset (local dev without Docker)
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

# API server config lives in apps/api/.env (see apps/api/.env.example):
# DATABASE_URL, AUTH_JWT_SECRET, SMTP_URL, S3_*, GOOGLE_*, OAUTH_*, REDIS_URL
