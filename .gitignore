# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
!apps/api/tests/fixtures/auth/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!apps/api/.env.example
!apps/api/.env.docker.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli local state (contains project refs)
/supabase/.temp/

# rust (api)
/apps/api/target/
/apps/api/lcov.info
/apps/api/coverage/
/apps/api/*.profraw
