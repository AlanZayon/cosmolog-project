# Copy to apps/api/.env.docker for docker compose dev (gitignored).
# DATABASE_URL / REDIS_URL / SMTP / MinIO / Fake IdP are set by docker-compose.dev.yml.

# Dev default is generated when unset (insecure); set your own if preferred.
# AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- Local stack (compose overrides these; listed for documentation) ---
# SMTP_URL=smtp://mailpit:1025
# SES_FROM_EMAIL=noreply@localhost
# S3_BUCKET=cosmolog
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_BASE_URL=http://localhost:9000/cosmolog
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# GOOGLE_CLIENT_ID=cosmolog-local
# GOOGLE_CLIENT_SECRET=cosmolog-local-secret
# OAUTH_TOKEN_URL=http://fake-idp:9090/token
# OAUTH_ISSUER=http://localhost:9090
# REQUIRE_EMAIL_CONFIRMATION=true
# APP_PUBLIC_URL=http://localhost:3000
# REDIS_URL=redis://redis:6379

# --- Optional: point at real AWS/Google instead of local stack ---
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=no-reply@your-domain.com
# S3_BUCKET=cosmolog-images
# S3_PUBLIC_BASE_URL=https://cdn.your-domain.com
