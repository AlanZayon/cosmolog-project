# Copy to apps/api/.env.docker for docker compose dev (gitignored).
# DATABASE_URL is set by docker-compose.dev.yml (local Postgres).

# Dev default is generated when unset (insecure); set your own if preferred.
# AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Google OAuth (optional in dev)
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# AWS SES/S3 (optional in dev; emails are logged and uploads disabled when unset)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SES_FROM_EMAIL=no-reply@your-domain.com
# S3_BUCKET=cosmolog-images
# S3_PUBLIC_BASE_URL=https://cdn.your-domain.com

# Set by docker-compose.dev.yml when using the dev stack
REDIS_URL=redis://redis:6379
