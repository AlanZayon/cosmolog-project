# Copy to apps/api/.env.docker for docker compose dev (gitignored).
# DATABASE_URL is set by docker-compose.dev.yml (local Postgres).
# Auth/storage still use your Supabase project.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_JWT_AUDIENCE=authenticated
