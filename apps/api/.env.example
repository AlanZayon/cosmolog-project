API_HOST=0.0.0.0
API_PORT=8080
# Own/managed PostgreSQL. (Legacy Supabase pooler URLs are still auto-rewritten.)
DATABASE_URL=postgresql://user:password@host:5432/cosmolog
# Optional overrides
# RUNTIME_DATABASE_URL=postgresql://user:password@host:5432/cosmolog
# MIGRATE_DATABASE_URL=postgresql://user:password@host:5432/cosmolog
CORS_ALLOWED_ORIGIN=http://localhost:3000
RUN_MIGRATIONS=true
RUST_LOG=cosmolog_api=debug,tower_http=debug,sqlx=warn

# --- Auth (own JWT, no Supabase) ---
# Required in production; >= 32 chars. Generate: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Public URL of the web app (email links). Defaults to CORS_ALLOWED_ORIGIN.
# APP_PUBLIC_URL=http://localhost:3000
# Require email confirmation before sign-in (default: true in production)
# REQUIRE_EMAIL_CONFIRMATION=false

# --- Google OAuth (direct, optional) ---
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# --- AWS (SES emails + S3 image storage) ---
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Verified SES sender. When unset, auth emails are logged instead of sent.
# SES_FROM_EMAIL=no-reply@your-domain.com
# S3 bucket for image uploads (avatars/covers/comics/...)
# S3_BUCKET=cosmolog-images
# Public base URL serving the bucket (CloudFront or S3 website), no trailing slash
# S3_PUBLIC_BASE_URL=https://cdn.your-domain.com
# Keep accepting image URLs from the old Supabase project during the transition
# LEGACY_SUPABASE_URL=https://your-project.supabase.co

# Optional in local dev (in-memory bus when unset). Required when APP_ENV=production.
# Start Redis: docker compose -f docker-compose.dev.yml up -d redis
# REDIS_URL=redis://127.0.0.1:6379
