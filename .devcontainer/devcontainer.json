{
  "name": "Cosmolog",
  "dockerComposeFile": "../docker-compose.dev.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000, 8080, 5434],
  "portsAttributes": {
    "3000": { "label": "Next.js", "onAutoForward": "notify" },
    "8080": { "label": "Rust API", "onAutoForward": "notify" },
    "5434": { "label": "Postgres (dev)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "npm ci && cd apps/api && cargo fetch",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "rust-analyzer.linkedProjects": ["apps/api/Cargo.toml"]
      }
    }
  },
  "remoteEnv": {
    "TEST_DATABASE_URL": "postgres://cosmolog:cosmolog@postgres:5432/cosmolog_dev"
  }
}
